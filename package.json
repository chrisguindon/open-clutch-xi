{
  "name": "open-clutch-xi",
  "private": true,
  "version": "0.1.1",
  "description": "Open Clutch XI: a free, open-source 3D football game for the browser, played against the computer. Built with Three.js and TypeScript.",
  "license": "EPL-2.0",
  "author": "Christopher Guindon",
  "homepage": "https://github.com/chrisguindon/open-clutch-xi#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/chrisguindon/open-clutch-xi"
  },
  "bugs": {
    "url": "https://github.com/chrisguindon/open-clutch-xi/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude \"tests/perf*.test.ts\" && vitest run tests/perf.test.ts tests/perf-render.test.ts",
    "test:watch": "vitest",
    "lint": "node tools/lint/node_modules/eslint/bin/eslint.js --config tools/lint/eslint.config.mjs .",
    "lint:setup": "npm ci --prefix tools/lint",
    "format": "prettier --write .",
    "check:format": "prettier --check .",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:repo": "node scripts/check-repo-hygiene.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:github": "node scripts/check-github-config.mjs",
    "ci": "npm run check:format && npm run lint && npm run typecheck && npm test && vite build && npm run check:licenses && npm run check:repo && npm run check:docs && npm run check:github && node scripts/generate-sbom.mjs --check",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:all": "npm test && npm run test:browser",
    "browsers:install": "node scripts/install-browser.mjs",
    "metrics": "node scripts/run-with-env.mjs METRICS=1 vitest run tests/tools/metrics-report.test.ts",
    "bench": "vitest run tests/perf.test.ts",
    "capture:review": "node scripts/review-capture.mjs review-after",
    "capture:perf": "node scripts/perf-capture.mjs after",
    "capture:anim": "node scripts/anim-capture.mjs after",
    "capture:replay": "node scripts/replay-capture.mjs",
    "capture:lighting": "node scripts/lighting-capture.mjs lighting-final high",
    "capture:player": "node scripts/player-capture.mjs after",
    "check:audio": "node scripts/audio-check.mjs",
    "build:assets": "node scripts/build-assets.mjs",
    "build:audio": "bash scripts/build-audio.sh",
    "check:fluidity": "node scripts/run-with-env.mjs NORENDER=1 node scripts/fluidity-check.mjs fluidity",
    "bench:headless": "node scripts/bench-capture.mjs headless high 5v5",
    "bench:cpu": "node scripts/cpu-microbench.mjs dist current high 5v5",
    "check:mobile": "node scripts/mobile-check.mjs",
    "check:mobile-hud": "node scripts/mobile-hud-check.mjs",
    "check:orientation": "node scripts/orientation-check.mjs",
    "check:anim": "node scripts/anim-compare.mjs",
    "check:input": "node scripts/input-check.mjs",
    "check:refresh": "node scripts/refresh-check.mjs 144",
    "check:tutorial": "node scripts/tutorial-check.mjs",
    "check:cup": "node scripts/cup-check.mjs",
    "check:prod": "npm run build && node scripts/prod-check.mjs",
    "capture:ui": "node scripts/ui-capture.mjs",
    "report:penalties": "node scripts/run-with-env.mjs PENALTIES=1 vitest run tests/tools/penalty-report.test.ts",
    "check:controls": "node scripts/controls-check.mjs",
    "check:adaptive": "node scripts/adaptive-check.mjs",
    "report:ai": "node scripts/run-with-env.mjs AI_AUDIT=1 vitest run tests/tools/ai-audit-report.test.ts",
    "check:rules": "node scripts/rules-check.mjs",
    "sbom": "node scripts/generate-sbom.mjs",
    "release:check": "node scripts/release-check.mjs",
    "release:package": "node scripts/package-web.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "release": "node scripts/release.mjs",
    "report:attack": "node scripts/run-with-env.mjs ATTACK=1 vitest run tests/tools/attack-report.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@puppeteer/browsers": "3.2.7",
    "@types/node": "26.6.6",
    "@types/three": "0.187.0",
    "meshoptimizer": "1.3.0",
    "prettier": "3.10.1",
    "puppeteer-core": "25.17.0",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  }
}
