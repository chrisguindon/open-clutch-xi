.env
.env.*
*.local
.npmrc

# Personal editor and OS files
.idea
.vscode/*
!.vscode/extensions.json
*.swp
.DS_Store
Thumbs.db
*.tmp

# Private, local-only development records (AI working notes, phase reports, benchmarks)
.local/

# Release artefacts (SBOM, packaged builds) — produced by npm run release:check / npm run sbom
release

# Personal Claude Code settings (the shared project settings in .claude/settings.json are committed)
.claude/settings.local.json

# Project-local tools downloaded on demand (the pinned browser for the browser checks: npm run browsers:install)
.cache/
